@netray-info:registry=https://npm.pkg.github.com
# Required for Docker builds (--mount=type=secret,id=NODE_AUTH_TOKEN,env=NODE_AUTH_TOKEN)
# and GitHub Actions setup-node (NODE_AUTH_TOKEN=${{ secrets.GITHUB_TOKEN }}).
# Do not remove — npm will silently fail to authenticate against GitHub Packages.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
