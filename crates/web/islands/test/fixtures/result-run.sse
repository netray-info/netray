\"></li>\n\n<li data-code=\"tls.cert_lifetime\" data-name=\"Lifetime TLS·19\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.san_quality\" data-name=\"SAN TLS·20\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.aia_reachability\" data-name=\"AIA TLS·21\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.tls_version\" data-name=\"Version TLS·22\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.forward_secrecy\" data-name=\"PFS TLS·23\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.aead_cipher\" data-name=\"AEAD TLS·24\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.ocsp_stapled\" data-name=\"OCSP TLS·25\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.ct_logged\" data-name=\"CT TLS·26\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.caa_compliant\" data-name=\"CAA ok TLS·27\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.dane_valid\" data-name=\"DANE TLS·28\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.consistency\" data-name=\"Consist TLS·29\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.alpn_consistency\" data-name=\"ALPN TLS·30\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.ech_advertised\" data-name=\"ECH TLS·31\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.https_redirect\" data-name=\"Redirect HTTP·32\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.hsts\" data-name=\"HSTS HTTP·33\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n<li data-code=\"http.cors\" data-name=\"CORS HTTP·34\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.cookie_secure\" data-name=\"Cookies HTTP·35\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.csp\" data-name=\"CSP HTTP·36\" data-sentence=\"not tested 