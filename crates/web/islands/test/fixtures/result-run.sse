event: fragment
data: {"id":"spectrum","html":"<figure id=\"spectrum\" data-island=\"spectrum\" data-refreshing>\n\n<div class=\"spectrum\">\n  <div class=\"spectrum__box\" style=\"min-width: calc(54 * var(--spectrum-line-pitch-min))\">\n    <div class=\"spectrum__label-band\" style=\"height: 56px\">\n      \n      <div class=\"spectrum__labels\" data-run=\"0\" data-shown>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 8.3333%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 21.2963%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 60.1852%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 82.4074%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 99.0741%; height: 8px\"></span>\n        \n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"dns.ns\" style=\"left: clamp(0px, 8.3333%, calc(100% - 17.64px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">NS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"tls.chain_trusted\" style=\"left: clamp(0px, 21.2963%, calc(100% - 38.10px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Trust</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"http.hsts\" style=\"left: clamp(0px, 60.1852%, calc(100% - 31.28px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">HSTS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"email.spf\" style=\"left: clamp(0px, 82.4074%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">SPF</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"ip.reputation\" style=\"left: clamp(0px, 99.0741%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Rep</span>\n        \n      </div>\n      \n      <div class=\"spectrum__labels\" data-run=\"1\">\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 8.3333%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 21.2963%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 60.1852%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 82.4074%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 99.0741%; height: 8px\"></span>\n        \n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"dns.ns\" style=\"left: clamp(0px, 8.3333%, calc(100% - 17.64px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">NS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"tls.chain_trusted\" style=\"left: clamp(0px, 21.2963%, calc(100% - 38.10px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Trust</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"http.hsts\" style=\"left: clamp(0px, 60.1852%, calc(100% - 31.28px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">HSTS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"email.spf\" style=\"left: clamp(0px, 82.4074%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">SPF</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"ip.reputation\" style=\"left: clamp(0px, 99.0741%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Rep</span>\n        \n      </div>\n      \n      <div class=\"spectrum__labels\" data-run=\"2\">\n        \n        \n      </div>\n      \n    </div>\n    <svg class=\"spectrum__plate\" role=\"img\" aria-label=\"Check results of shop.example.com\">\n      \n      <g id=\"band-dns\" data-protocol=\"dns\">\n        \n        \n        <g class=\"spectrum__run\" data-run=\"0\" data-shown>\n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.dnssec\" x1=\"0.9259%\" x2=\"0.9259%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.dnskey_algorithm\" x1=\"2.7778%\" x2=\"2.7778%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.dnssec_rollover\" x1=\"4.6296%\" x2=\"4.6296%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.caa\" x1=\"6.4815%\" x2=\"6.4815%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"warn\" data-code=\"dns.ns\" x1=\"8.3333%\" x2=\"8.3333%\" y1=\"100%\" y2=\"27.8571%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.ns_lame\" x1=\"10.1852%\" x2=\"10.1852%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.ns_delegation\" x1=\"12.0370%\" x2=\"12.0370%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.cname_apex\" x1=\"13.8889%\" x2=\"13.8889%\" y1=\"100%\" y2=\"46.4286%\" />\n    