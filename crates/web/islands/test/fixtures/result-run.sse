event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<div hidden>\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group issues by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<h3>your DNS provider</h3>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">dns.ns</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-dns\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"web_server\">\n<h3>your web server configuration</h3>\n\n<div class=\"issue\" data-owner=\"web_server\" data-severity=\"critical\" data-protocol=\"tls\" data-status=\"warn\" data-order=\"11\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">tls.chain_trusted</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Chain trusted</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-tls\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

event: fragment
data: {"id":"evidence-tls","html":"<div id=\"evidence-tls\">\n\n\n\n<section class=\"evidence-section\" data-protocol=\"tls\">\n\n<p class=\"run-line\">\n  <span class=\"run-line__part\">live</span>&#32;<span class=\"run-line__sep\" aria-hidden=\"true\">·</span>&#32;<span class=\"run-line__part\">not recorded</span>\n</p>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Reach</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">TLS reachable</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/tls-protocol\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Trust</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Chain trusted</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Expired</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Certificate valid</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Hostname</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Hostname match</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Chain</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Chain complete</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Sig</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Strong signature</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Key</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Key strength</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Renewal</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Expiry window</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-management\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Lifetime</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Certificate lifetime</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-management\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">SAN</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">SAN quality</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-management\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">AIA</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">AIA reachable</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-management\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Version</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">TLS version</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/tls-protocol\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">PFS</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Forward secrecy</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/tls-protocol\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">AEAD</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">AEAD cipher</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/tls-protocol\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">OCSP</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">OCSP stapling</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">CT</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">CT logged</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-transparency\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">CAA ok</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">CAA compliant</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/caa-records\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">DANE</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DANE valid</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dane-tlsa\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Consist</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Multi-IP consistency</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/multi-ip-tls\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">ALPN</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">ALPN consistency</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/multi-ip-tls\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">ECH</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">ECH advertised</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/encrypted-client-hello\">Guide</a>\n  </p>\n</article>\n\n\n\n\n\n</section>\n</div>"}

