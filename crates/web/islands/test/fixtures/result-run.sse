data: {"id":"evidence-email","html":"<div id=\"evidence-email\" class=\"evidence-tabs__panel\" data-panel=\"email\">\n\n\n\n<div class=\"evidence-tabs__links\">\n\n\n<a class=\"evidence-tabs__explore\" href=\"/inspect/dns?q=shop.example.com%20MX\">Open in the DNS inspector →</a>\n</div>\n\n\n</div>"}

