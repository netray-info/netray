=\"26.8519%\" x2=\"26.8519%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.strong_signature\" x1=\"28.7037%\" x2=\"28.7037%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.key_strength\" x1=\"30.5556%\" x2=\"30.5556%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.expiry_window\" x1=\"32.4074%\" x2=\"32.4074%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.cert_lifetime\" x1=\"34.2593%\" x2=\"34.2593%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.san_quality\" x1=\"36.1111%\" x2=\"36.1111%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.aia_reachability\" x1=\"37.9630%\" x2=\"37.9630%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.tls_version\" x1=\"39.8148%\" x2=\"39.8148%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.forward_secrecy\" x1=\"41.6667%\" x2=\"41.6667%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.aead_cipher\" x1=\"43.5185%\" x2=\"43.5185%\" y1=\"100%\" y2=\"71.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"tls.ocsp_stapled\" x1=\"45.3704%\" x2=\"45.3704%\" y1=\"100%\