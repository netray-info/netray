event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<h2>3 lines need attention</h2>\n<div hidden>\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group issues by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<h3>your DNS provider</h3>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"your DNS provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">dns.ns</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-dns\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"web_server\">\n<h3>your web server configuration</h3>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"your web server configuration\" data-severity=\"critical\" data-protocol=\"tls\" data-status=\"warn\" data-order=\"11\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">tls.chain_trusted</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Chain trusted</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-tls\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"your web server configuration\" data-severity=\"high\" data-protocol=\"http\" data-status=\"warn\" data-order=\"32\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">http.hsts</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">HSTS</h3>\n    \n  </header>\n  <p class=\"check-row__body\">HTTPS responses carry no Strict-Transport-Security header, or one with a max-age below one year.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Send Strict-Transport-Security with max-age=31536000 on all HTTPS responses.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-http\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/hsts\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

event: fragment
data: {"id":"evidence-http","html":"<div id=\"evidence-http\">\n\n\n\n<section class=\"evidence-section\" data-protocol=\"http\">\n\n<p class=\"run-line\">\n  <span class=\"run-line__part\">live</span>&#32;<span class=\"run-line__sep\" aria-hidden=\"true\">·</span>&#32;<span class=\"run-line__part\">not recorded</span>\n</p>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Redirect</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">HTTPS redirect</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/hsts\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">HSTS</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">HSTS</h3>\n    \n  </header>\n  <p class=\"check-row__body\">HTTPS responses carry no Strict-Transport-Security header, or one with a max-age below one year.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Send Strict-Transport-Security with max-age=31536000 on all HTTPS responses.</p>\n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/hsts\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">CORS</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">CORS policy</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/cors\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Cookies</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Secure cookies</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/cookie-security\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">CSP</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Content Security Policy</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/csp\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">XFO</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">X-Frame-Options</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/security-headers\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">XCTO</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">X-Content-Type-Options</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/security-headers\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Referrer</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Referrer-Policy</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/security-headers\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Perms</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Permissions-Policy</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/security-headers\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Legacy</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Deprecated headers</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/http-redirects\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Leakage</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Information leakage</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/http-redirects\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Caching</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Cache control</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/http-redirects\">Guide</a>\n  </p>\n</article>\n\n\n\n\n\n</section>\n</div>"}

