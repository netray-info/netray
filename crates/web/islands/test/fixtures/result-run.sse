event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<h2>4 lines need attention</h2>\n<div hidden>\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group issues by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<h3>your DNS provider</h3>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"your DNS provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">dns.ns</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-dns\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"your DNS provider\" data-severity=\"medium\" data-protocol=\"email\" data-status=\"warn\" data-order=\"44\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">email.spf</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">SPF</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain&#39;s SPF record is missing or invalid, leaves out the addresses of MX hosts the domain operates itself, or lacks -all although the domain publishes a Null MX.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Publish one SPF record that lists every server sending mail for the domain, including its own MX hosts that also send, and ends in -all, or ~all where the domain does not publish a Null MX.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-email\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/email-auth\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"web_server\">\n<h3>your web server configuration</h3>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"your web server configuration\" data-severity=\"critical\" data-protocol=\"tls\" data-status=\"warn\" data-order=\"11\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">tls.chain_trusted</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Chain trusted</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-tls\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"your web server configuration\" data-severity=\"high\" data-protocol=\"http\" data-status=\"warn\" data-order=\"32\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">http.hsts</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">HSTS</h3>\n    \n  </header>\n  <p class=\"check-row__body\">HTTPS responses carry no Strict-Transport-Security header, or one with a max-age below one year.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Send Strict-Transport-Security with max-age=31536000 on all HTTPS responses.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-http\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/hsts\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

event: fragment
data: {"id":"evidence-email","html":"<div id=\"evidence-email\">\n\n\n\n<section class=\"evidence-section\" data-protocol=\"email\">\n\n<p class=\"run-line\">\n  <span class=\"run-line__part\">live</span>&#32;<span class=\"run-line__sep\" aria-hidden=\"true\">·</span>&#32;<span class=\"run-line__part\">not recorded</span>\n</p>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">MX</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">MX records</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/email-deliverability\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">SPF</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">SPF</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain&#39;s SPF record is missing or invalid, leaves out the addresses of MX hosts the domain operates itself, or lacks -all although the domain publishes a Null MX.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Publish one SPF record that lists every server sending mail for the domain, including its own MX hosts that also send, and ends in -all, or ~all where the domain does not publish a Null MX.</p>\n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/email-auth\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">DKIM</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DKIM</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dkim\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">DMARC</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DMARC</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/email-auth\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">MTA-STS</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">MTA-STS</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/mta-sts\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">TLS-RPT</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">TLS-RPT</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/tls-rpt\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">BIMI</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">BIMI</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/bimi\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">MX DANE</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">SMTP DANE</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dane-tlsa\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">DNSBL</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DNS blocklists</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dnsbl\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">FCrDNS</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Forward-confirmed rDNS</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dnsbl\">Guide</a>\n  </p>\n</article>\n\n\n\n\n\n</section>\n</div>"}

event: fragment
data: {"id":"progress","html":"<div id=\"progress\">\n<ol class=\"progress-ray\" aria-label=\"Check progress\">\n  \n  <li class=\"progress-ray__segment\" data-state=\"done\"><span class=\"progress-ray__label\">dns</span> <span class=\"progress-ray__state\">done</span></li>\n  \n  <li class=\"progress-ray__segment\" data-state=\"done\"><span class=\"progress-ray__label\">tls</span> <span class=\"progress-ray__state\">done</span></li>\n  \n  <li class=\"progress-ray__segment\" data-state=\"done\"><span class=\"progress-ray__label\">http</span> <span class=\"progress-ray__state\">done</span></li>\n  \n  <li class=\"progress-ray__segment\" data-state=\"done\"><span class=\"progress-ray__label\">email</span> <span class=\"progress-ray__state\">done</span></li>\n  \n  <li class=\"progress-ray__segment\" data-state=\"done\"><span class=\"progress-ray__label\">ip</span> <span class=\"progress-ray__state\">done</span></li>\n  \n</ol>\n</div>"}

event: fragment
data: {"id":"spectrum","html":"<figure id=\"spectrum\" data-island=\"spectrum\" data-refreshing>\n\n<div class=\"spectrum\">\n  <div class=\"spectrum__box\" style=\"min-width: calc(54 * var(--spectrum-line-pitch-min))\">\n    <div class=\"spectrum__label-band\" style=\"height: 56px\">\n      \n      <div class=\"spectrum__labels\" data-run=\"0\" data-shown>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 8.3333%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 21.2963%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 60.1852%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 82.4074%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 99.0741%; height: 8px\"></span>\n        \n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"dns.ns\" style=\"left: clamp(0px, 8.3333%, calc(100% - 17.64px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">NS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"tls.chain_trusted\" style=\"left: clamp(0px, 21.2963%, calc(100% - 38.10px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Trust</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"http.hsts\" style=\"left: clamp(0px, 60.1852%, calc(100% - 31.28px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">HSTS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"email.spf\" style=\"left: clamp(0px, 82.4074%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">SPF</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"ip.reputation\" style=\"left: clamp(0px, 99.0741%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Rep</span>\n        \n      </div>\n      \n      <div class=\"spectrum__labels\" data-run=\"1\">\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 8.3333%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 21.2963%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 60.1852%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 82.4074%; height: 8px\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 99.0741%; height: 8px\"></span>\n        \n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"dns.ns\" style=\"left: clamp(0px, 8.3333%, calc(100% - 17.64px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">NS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"tls.chain_trusted\" style=\"left: clamp(0px, 21.2963%, calc(100% - 38.10px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Trust</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"http.hsts\" style=\"left: clamp(0px, 60.1852%, calc(100% - 31.28px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">HSTS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"email.spf\" style=\"left: clamp(0px, 82.4074%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">SPF</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"ip.reputation\" style=\"left: clamp(0px, 99.0741%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Rep</span>\n        \n      </div>\n      \n      <div class=\"spectrum__labels\" data-run=\"2\">\n        \n        \n      </div>\n      \n    </div>\n    <svg class=\"spectrum__plate\" role=\"img\" aria-label=\"Check results of shop.example.com\">\n      \n      <g id=\"band-dns\" data-protocol=\"dns\" data-live>\n        \n        \n        <g class=\"spectrum__run\" data-run=\"0\" data-shown>\n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.dnssec\" x1=\"0.9259%\" x2=\"0.9259%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.dnskey_algorithm\" x1=\"2.7778%\" x2=\"2.7778%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.dnssec_rollover\" x1=\"4.6296%\" x2=\"4.6296%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.caa\" x1=\"6.4815%\" x2=\"6.4815%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"warn\" data-code=\"dns.ns\" x1=\"8.3333%\" x2=\"8.3333%\" y1=\"100%\" y2=\"27.8571%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.ns_lame\" x1=\"10.1852%\" x2=\"10.1852%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.ns_delegation\" x1=\"12.0370%\" x2=\"12.0370%\" y1=\"100%\" y2=\"46.4286%\" />\n          \n          \n          \n          <line class=\"spectrum__line\" data-tone=\"untested\" data-code=\"dns.cname_apex\" x1=\"13.8889%\" x2=\"13.8889%\" y1=\"100%\" y2=\"46.4286%\