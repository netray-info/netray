k\" href=\"/guide/tls-protocol\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">PFS</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Forward secrecy</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/tls-protocol\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">AEAD</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">AEAD cipher</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/tls-protocol\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">OCSP</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">OCSP stapling</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">CT</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">CT logged</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/certificate-transparency\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">CAA ok</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">CAA compliant</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/caa-records\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">DANE</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DANE valid</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dane-tlsa\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Consist</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Multi-IP consistency</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/multi-ip-tls\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">ALPN</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">ALPN consistency</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/multi-ip-tls\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">ECH</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">ECH advertised</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/encrypted-client-hello\">Guide</a>\n  </p>\n</article>\n\n\n\n\n\n</section>\n</div>"}

