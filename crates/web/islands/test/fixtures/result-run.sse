not tested since 10-09\"></li>\n\n<li data-code=\"tls.ct_logged\" data-name=\"CT TLS·26\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.caa_compliant\" data-name=\"CAA ok TLS·27\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.dane_valid\" data-name=\"DANE TLS·28\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.consistency\" data-name=\"Consist TLS·29\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.alpn_consistency\" data-name=\"ALPN TLS·30\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.ech_advertised\" data-name=\"ECH TLS·31\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.https_redirect\" data-name=\"Redirect HTTP·32\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.hsts\" data-name=\"HSTS HTTP·33\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n<li data-code=\"http.cors\" data-name=\"CORS HTTP·34\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.cookie_secure\" data-name=\"Cookies HTTP·35\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.csp\" data-name=\"CSP HTTP·36\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.x_frame_options\" data-name=\"XFO HTTP·37\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.x_content_type_options\" data-name=\"XCTO HTTP·38\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.referrer_policy\" data-name=\"Referrer HTTP·39\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.permissions_policy\" data-name=\"Perms HTTP·40\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.deprecated_headers\" data-name=\"Legacy HTTP·41\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.info_leakage\" data-name=\"Leakage HTTP·42\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.caching\" data-name=\"Caching HTTP·43\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.mx\" data-name=\"MX MAIL·44\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.spf\" data-name=\"SPF MAIL·45\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n<li data-code=\"email.dkim\" data-name=\"DKIM MAIL·46\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.dmarc\" data-name=\"DMARC MAIL·47\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.mta_sts\" data-name=\"MTA-STS MAIL·48\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.tls_rpt\" data-name=\"TLS-RPT MAIL·49\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.bimi\" data-name=\"BIMI MAIL·50\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.dane\" data-name=\"MX DANE MAIL·51\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.dnsbl\" data-name=\"DNSBL MAIL·52\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.fcrdns\" data-name=\"FCrDNS MAIL·53\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"ip.reputation\" data-name=\"Rep IP·54\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n</ul>\n</figure>"}

event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<div class=\"section-head section-head--split\">\n<h2>3 lines need attention</h2>\n<p class=\"attention-meta\">0 fail · 3 warn</p>\n\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group lines by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">Owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">Severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">Protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"web_server\">\n<header class=\"issue-group__head\"><h3 class=\"issue-group__label\">Your web server configuration</h3><span class=\"issue-group__count\">2 lines</span></header>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"Your web server configuration\" data-severity=\"critical\" data-protocol=\"tls\" data-status=\"warn\" data-order=\"11\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">TLS·12</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"tls.chain_trusted\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · TLS·12</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">Chain trusted</h3>\n      \n    </div>\n    <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n    <p class=\"check-row__meta\"><span>TLS · RFC 5280</span><a class=\"check-row__link\" href=\"#evidence-tls\">evidence →</a><a class=\"check-row__link\" href=\"/guide/certificate-chain\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"Your web server configuration\" data-severity=\"high\" data-protocol=\"http\" data-status=\"warn\" data-order=\"32\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">HTTP·33</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"http.hsts\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · HTTP·33</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">HSTS</h3>\n      \n    </div>\n    <p class=\"check-row__body\">HTTPS responses carry no Strict-Transport-Security header, or one with a max-age below one year.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Send Strict-Transport-Security with max-age=31536000 on all HTTPS responses.</p>\n    <p class=\"check-row__meta\"><span>HTTP · RFC 6797</span><a class=\"check-row__link\" href=\"#evidence-http\">evidence →</a><a class=\"check-row__link\" href=\"/guide/hsts\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<header class=\"issue-group__head\"><h3 class=\"issue-group__label\">Your DNS provider</h3><span class=\"issue-group__count\">1 line</span></header>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"Your DNS provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">DNS·05</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"dns.ns\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · DNS·05</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n      \n    </div>\n    <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n    <p class=\"check-row__meta\"><span>DNS · RFC 2182</span><a class=\"check-row__link\" href=\"#evidence-dns\">evidence →</a><a class=\"check-row__link\" href=\"/guide/record-types\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

