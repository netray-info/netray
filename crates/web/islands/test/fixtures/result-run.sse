data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<div hidden>\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group issues by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<h3>your DNS provider</h3>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">dns.ns</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-dns\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-severity=\"medium\" data-protocol=\"email\" data-status=\"warn\" data-order=\"44\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">email.spf</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">SPF</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain&#39;s SPF record is missing or invalid, leaves out the addresses of MX hosts the domain operates itself, or lacks -all although the domain publishes a Null MX.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Publish one SPF record that lists every server sending mail for the domain, including its own MX hosts that also send, and ends in -all, or ~all where the domain does not publish a Null MX.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-email\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/email-auth\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"web_server\">\n<h3>your web server configuration</h3>\n\n<div class=\"issue\" data-owner=\"web_server\" data-severity=\"critical\" data-protocol=\"tls\" data-status=\"warn\" data-order=\"11\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">tls.chain_trusted</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Chain trusted</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-tls\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"web_server\" data-severity=\"high\" data-protocol=\"http\" data-status=\"warn\" data-order=\"32\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">http.hsts</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">HSTS</h3>\n    \n  </header>\n  <p class=\"check-row__body\">HTTPS responses carry no Strict-Transport-Security header, or one with a max-age below one year.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Send Strict-Transport-Security with max-age=31536000 on all HTTPS responses.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-http\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/hsts\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"hosting\">\n<h3>your hosting provider</h3>\n\n<div class=\"issue\" data-owner=\"hosting\" data-severity=\"high\" data-protocol=\"ip\" data-status=\"warn\" data-order=\"53\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">ip.reputation</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">IP reputation</h3>\n    \n  </header>\n  <p class=\"check-row__body\">An address of the domain is listed by Spamhaus, flagged as a Tor exit node or a command-and-control server, or flagged as a VPN endpoint.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Investigate the flagged address, request delisting where the source offers it, or stop using the address for the service.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-ip\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/ip-enrichment\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

event: fragment
data: {"id":"evidence-ip","html":"<div id=\"evidence-ip\">\n\n\n\n<section class=\"evidence-section\" data-protocol=\"ip\">\n\n<p class=\"run-line\">\n  <span class=\"run-line__part\">live</span>&#32;<span class=\"run-line__sep\" aria-hidden=\"true\">·</span>&#32;<span class=\"run-line__part\">not recorded</span>\n</p>\n\n\n\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Rep</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">IP reputation</h3>\n    \n  </header>\n  <p class=\"check-row__body\">An address of the domain is listed by Spamhaus, flagged as a Tor exit node or a command-and-control server, or flagged as a VPN endpoint.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Investigate the flagged address, request delisting where the source offers it, or stop using the address for the service.</p>\n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/ip-enrichment\">Guide</a>\n  </p>\n</article>\n\n\n\n\n\n</section>\n</div>"}

event: fragment
data: {"id":"result-grade","html":"<div id=\"result-grade\">\n<div class=\"grade\" data-tone=\"pass\">\n  <span class=\"grade__letter\">B</span>\n  \n</div>\n</div>"}

