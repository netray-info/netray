event: fragment
data: {"id":"diff","html":"<section id=\"diff\">\n<div class=\"section-head\"><h2>Since run 1</h2>\n<p class=\"since-meta\">2025-10-09 · grade A → B</p>\n</div>\n\n<section class=\"diff-block\">\n  \n  \n  <ul class=\"diff-block__entries\">\n    \n    <li class=\"diff-block__entry\" data-tone=\"warn\">\n      <span class=\"diff-block__marker\" aria-hidden=\"true\"></span>\n      <span class=\"diff-block__kind\">new</span>\n      <span class=\"diff-block__text\">Nameserver redundancy</span>\n      <span class=\"diff-block__code\">DNS·05</span>\n    </li>\n    \n    <li class=\"diff-block__entry\" data-tone=\"warn\">\n      <span class=\"diff-block__marker\" aria-hidden=\"true\"></span>\n      <span class=\"diff-block__kind\">new</span>\n      <span class=\"diff-block__text\">Chain trusted</span>\n      <span class=\"diff-block__code\">TLS·12</span>\n    </li>\n    \n    <li class=\"diff-block__entry\" data-tone=\"warn\">\n      <span class=\"diff-block__marker\" aria-hidden=\"true\"></span>\n      <span class=\"diff-block__kind\">new</span>\n      <span class=\"diff-block__text\">HSTS</span>\n      <span class=\"diff-block__code\">HTTP·33</span>\n    </li>\n    \n    <li class=\"diff-block__entry\" data-tone=\"warn\">\n      <span class=\"diff-block__marker\" aria-hidden=\"true\"></span>\n      <span class=\"diff-block__kind\">new</span>\n      <span class=\"diff-block__text\">SPF</span>\n      <span class=\"diff-block__code\">MAIL·45</span>\n    </li>\n    \n    <li class=\"diff-block__entry\" data-tone=\"warn\">\n      <span class=\"diff-block__marker\" aria-hidden=\"true\"></span>\n      <span class=\"diff-block__kind\">new</span>\n      <span class=\"diff-block__text\">IP reputation</span>\n      <span class=\"diff-block__code\">IP·54</span>\n    </li>\n    \n  </ul>\n  \n</section>\n\n</section>"}

event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<h2>5 lines need attention</h2>\n<div hidden>\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group issues by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<h3>your DNS provider</h3>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"your DNS provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">dns.ns</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n    <span class=\"check-row__since\">10-09</span>\n  </header>\n  <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"/r/ENTRY0/dns\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"your DNS provider\" data-severity=\"medium\" data-protocol=\"email\" data-status=\"warn\" data-order=\"44\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">email.spf</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">SPF</h3>\n    <span class=\"check-row__since\">10-09</span>\n  </header>\n  <p class=\"check-row__body\">The domain&#39;s SPF record is missing or invalid, leaves out the addresses of MX hosts the domain operates itself, or lacks -all although the domain publishes a Null MX.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Publish one SPF record that lists every server sending mail for the domain, including its own MX hosts that also send, and ends in -all, or ~all where the domain does not publish a Null MX.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"/r/ENTRY0/email\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/email-auth\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"web_server\">\n<h3>your web server configuration</h3>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"your web server configuration\" data-severity=\"critical\" data-protocol=\"tls\" data-status=\"warn\" data-order=\"11\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">tls.chain_trusted</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Chain trusted</h3>\n    <span class=\"check-row__since\">10-09</span>\n  </header>\n  <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"/r/ENTRY0/tls\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/certificate-chain\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"your web server configuration\" data-severity=\"high\" data-protocol=\"http\" data-status=\"warn\" data-order=\"32\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">http.hsts</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">HSTS</h3>\n    <span class=\"check-row__since\">10-09</span>\n  </header>\n  <p class=\"check-row__body\">HTTPS responses carry no Strict-Transport-Security header, or one with a max-age below one year.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Send Strict-Transport-Security with max-age=31536000 on all HTTPS responses.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"/r/ENTRY0/http\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/hsts\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"hosting\">\n<h3>your hosting provider</h3>\n\n<div class=\"issue\" data-owner=\"hosting\" data-owner-label=\"your hosting provider\" data-severity=\"high\" data-protocol=\"ip\" data-status=\"warn\" data-order=\"53\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">ip.reputation</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">IP reputation</h3>\n    <span class=\"check-row__since\">10-09</span>\n  </header>\n  <p class=\"check-row__body\">An address of the domain is listed by Spamhaus, flagged as a Tor exit node or a command-and-control server, or flagged as a VPN endpoint.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Investigate the flagged address, request delisting where the source offers it, or stop using the address for the service.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"/r/ENTRY0/ip\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/ip-enrichment\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

