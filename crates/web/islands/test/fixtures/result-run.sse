n<span class=\"legend__note\">57 checks · line height = weight in the grade</span>\n\n</div>\n<ul id=\"spectrum-sentences\" hidden>\n\n<li data-code=\"dns.dnssec\" data-name=\"DNSSEC DNS·01\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.dnskey_algorithm\" data-name=\"DNSKEY DNS·02\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.dnssec_rollover\" data-name=\"Rollover DNS·03\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.caa\" data-name=\"CAA DNS·04\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.ns\" data-name=\"NS DNS·05\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n<li data-code=\"dns.ns_lame\" data-name=\"Lame NS DNS·06\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.ns_delegation\" data-name=\"Deleg DNS·07\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.cname_apex\" data-name=\"Apex DNS·08\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.https_svcb\" data-name=\"HTTPS RR DNS·09\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"dns.ttl\" data-name=\"TTL DNS·10\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.tls_reachable\" data-name=\"Reach TLS·11\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.chain_trusted\" data-name=\"Trust TLS·12\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n<li data-code=\"tls.not_expired\" data-name=\"Expired TLS·13\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.hostname_match\" data-name=\"Hostname TLS·14\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.chain_complete\" data-name=\"Chain TLS·15\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.strong_signature\" data-name=\"Sig TLS·16\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.key_strength\" data-name=\"Key TLS·17\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.expiry_window\" data-name=\"Expiry TLS·18\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.cert_lifetime\" data-name=\"Lifetime TLS·19\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.san_quality\" data-name=\"SAN TLS·20\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.aia_reachability\" data-name=\"AIA TLS·21\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.tls_version\" data-name=\"Version TLS·22\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.forward_secrecy\" data-name=\"PFS TLS·23\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.aead_cipher\" data-name=\"AEAD TLS·24\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.legacy_versions\" data-name=\"Legacy TLS·25\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.weak_suites\" data-name=\"Suites TLS·26\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.ocsp_stapled\" data-name=\"OCSP TLS·27\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.ct_logged\" data-name=\"CT TLS·28\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.caa_compliant\" data-name=\"CAA ok TLS·29\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.dane_valid\" data-name=\"DANE TLS·30\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.consistency\" data-name=\"Consist TLS·31\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.alpn_consistency\" data-name=\"ALPN TLS·32\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"tls.ech_advertised\" data-name=\"ECH TLS·33\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.https_redirect\" data-name=\"Redirect HTTP·34\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.hsts\" data-name=\"HSTS HTTP·35\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n<li data-code=\"http.cors\" data-name=\"CORS HTTP·36\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.cookie_secure\" data-name=\"Cookies HTTP·37\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.csp\" data-name=\"CSP HTTP·38\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.x_frame_options\" data-name=\"XFO HTTP·39\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.x_content_type_options\" data-name=\"XCTO HTTP·40\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.referrer_policy\" data-name=\"Referrer HTTP·41\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.permissions_policy\" data-name=\"Perms HTTP·42\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.coop\" data-name=\"COOP HTTP·43\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.deprecated_headers\" data-name=\"Legacy HTTP·44\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.info_leakage\" data-name=\"Leakage HTTP·45\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"http.caching\" data-name=\"Caching HTTP·46\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.mx\" data-name=\"MX MAIL·47\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.spf\" data-name=\"SPF MAIL·48\" data-sentence=\"pass 10-09 · warn since 10-09\"></li>\n\n<li data-code=\"email.dkim\" data-name=\"DKIM MAIL·49\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.dmarc\" data-name=\"DMARC MAIL·50\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.mta_sts\" data-name=\"MTA-STS MAIL·51\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.tls_rpt\" data-name=\"TLS-RPT MAIL·52\" data-sentence=\"not tested since 10-09\"></li>\n\n<li data-code=\"email.bimi\" data-n