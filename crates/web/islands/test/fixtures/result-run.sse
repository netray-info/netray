event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<div hidden>\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group issues by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<h3>your DNS provider</h3>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">dns.ns</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n  <p class=\"check-row__links\">\n    <a class=\"check-row__link\" href=\"#evidence-dns\">Evidence</a>\n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

event: fragment
data: {"id":"evidence-dns","html":"<div id=\"evidence-dns\">\n\n\n\n<section class=\"evidence-section\" data-protocol=\"dns\">\n\n<p class=\"run-line\">\n  <span class=\"run-line__part\">live</span>&#32;<span class=\"run-line__sep\" aria-hidden=\"true\">·</span>&#32;<span class=\"run-line__part\">not recorded</span>\n</p>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">DNSSEC</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DNSSEC signed</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dnssec\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">DNSKEY</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DNSKEY algorithm</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dnssec\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Rollover</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">DNSSEC key rollover</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/dnssec\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">CAA</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">CAA records</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/caa-records\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">NS</span>\n    <span class=\"check-row__tone\">warn</span>\n    <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n    \n  </header>\n  <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n  <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Lame NS</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Lame delegation</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/lame-delegation\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Deleg</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">Delegation consistency</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/lame-delegation\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">Apex</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">No CNAME at apex</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">HTTPS RR</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">HTTPS record</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n\n\n\n<article class=\"check-row\" data-tone=\"untested\">\n  <header class=\"check-row__head\">\n    <span class=\"check-row__code\">TTL</span>\n    <span class=\"check-row__tone\">untested</span>\n    <h3 class=\"check-row__title\">TTL range</h3>\n    \n  </header>\n  <p class=\"check-row__body\"></p>\n  \n  <p class=\"check-row__links\">\n    \n    <a class=\"check-row__link\" href=\"/guide/record-types\">Guide</a>\n  </p>\n</article>\n\n\n\n\n\n</section>\n</div>"}

