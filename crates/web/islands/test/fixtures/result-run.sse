event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<div class=\"section-head section-head--split\">\n<h2>4 lines need attention</h2>\n<p class=\"attention-meta\">0 fail · 4 warn</p>\n\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group lines by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">Owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">Severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">Protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"web_server\">\n<header class=\"issue-group__head\"><h3 class=\"issue-group__label\">Your web server configuration</h3><span class=\"issue-group__count\">2 lines</span></header>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"Your web server configuration\" data-severity=\"critical\" data-protocol=\"tls\" data-status=\"warn\" data-order=\"11\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">TLS·12</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"tls.chain_trusted\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · TLS·12</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">Chain trusted</h3>\n      \n    </div>\n    <p class=\"check-row__body\">The served certificate chain does not build to a trust anchor in the public trust stores.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Install a certificate from a public CA together with its full intermediate chain.</p>\n    <p class=\"check-row__meta\"><span>TLS · RFC 5280</span><a class=\"check-row__link\" href=\"#evidence-tls\">evidence →</a><a class=\"check-row__link\" href=\"/guide/certificate-chain\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"web_server\" data-owner-label=\"Your web server configuration\" data-severity=\"high\" data-protocol=\"http\" data-status=\"warn\" data-order=\"34\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">HTTP·35</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"http.hsts\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · HTTP·35</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">HSTS</h3>\n      \n    </div>\n    <p class=\"check-row__body\">HTTPS responses carry no Strict-Transport-Security header, or one with a max-age below one year.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Send Strict-Transport-Security with max-age=31536000 on all HTTPS responses.</p>\n    <p class=\"check-row__meta\"><span>HTTP · RFC 6797</span><a class=\"check-row__link\" href=\"#evidence-http\">evidence →</a><a class=\"check-row__link\" href=\"/guide/hsts\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n</section>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<header class=\"issue-group__head\"><h3 class=\"issue-group__label\">Your DNS provider</h3><span class=\"issue-group__count\">2 lines</span></header>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"Your DNS provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">DNS·05</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"dns.ns\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · DNS·05</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n      \n    </div>\n    <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n    <p class=\"check-row__meta\"><span>DNS · RFC 2182</span><a class=\"check-row__link\" href=\"#evidence-dns\">evidence →</a><a class=\"check-row__link\" href=\"/guide/record-types\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"Your DNS provider\" data-severity=\"medium\" data-protocol=\"email\" data-status=\"warn\" data-order=\"47\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">MAIL·48</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"email.spf\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · MAIL·48</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">SPF</h3>\n      \n    </div>\n    <p class=\"check-row__body\">The domain&#39;s SPF record is missing or invalid, leaves out the addresses of MX hosts the domain operates itself, or lacks -all although the domain publishes a Null MX.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Publish one SPF record that lists every server sending mail for the domain, including its own MX hosts that also send, and ends in -all, or ~all where the domain does not publish a Null MX.</p>\n    <p class=\"check-row__meta\"><span>Email · RFC 7208</span><a class=\"check-row__link\" href=\"#evidence-email\">evidence →</a><a class=\"check-row__link\" href=\"/guide/email-auth\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

