event: fragment
data: {"id":"issues","html":"<section id=\"issues\" data-island=\"issues\">\n<div class=\"section-head section-head--split\">\n<h2>1 line needs attention</h2>\n<p class=\"attention-meta\">0 fail · 1 warn</p>\n\n<div class=\"grouping-switch\" role=\"group\" aria-label=\"Group lines by\">\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"owner\" aria-pressed=\"true\">Owner</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"severity\" aria-pressed=\"false\">Severity</button>\n  \n  <button type=\"button\" class=\"grouping-switch__option marker\" data-group=\"protocol\" aria-pressed=\"false\">Protocol</button>\n  \n</div>\n</div>\n\n<section class=\"issue-group\" data-group=\"dns_provider\">\n<header class=\"issue-group__head\"><h3 class=\"issue-group__label\">Your DNS provider</h3><span class=\"issue-group__count\">1 line</span></header>\n\n<div class=\"issue\" data-owner=\"dns_provider\" data-owner-label=\"Your DNS provider\" data-severity=\"medium\" data-protocol=\"dns\" data-status=\"warn\" data-order=\"4\">\n\n<article class=\"check-row\" data-tone=\"warn\">\n  <div class=\"check-row__side\">\n    <span class=\"check-row__bar\" data-tone=\"warn\"></span>\n    <span class=\"check-row__sev\">warn</span>\n    <span class=\"check-row__code\">DNS·05</span>\n  </div>\n  <div class=\"check-row__main\" data-check=\"dns.ns\">\n    <p class=\"check-row__phone-meta\"><span class=\"check-row__sev\">warn</span> · DNS·05</p>\n    <div class=\"check-row__head\">\n      <h3 class=\"check-row__title\">Nameserver redundancy</h3>\n      \n    </div>\n    <p class=\"check-row__body\">The domain has fewer than two NS records.</p>\n    <p class=\"check-row__fix\"><span class=\"check-row__fix-label\">Fix:</span> Delegate the zone to at least two authoritative nameservers.</p>\n    <p class=\"check-row__meta\"><span>DNS · RFC 2182</span><a class=\"check-row__link\" href=\"#evidence-dns\">evidence →</a><a class=\"check-row__link\" href=\"/guide/record-types\">guide →</a></p>\n  </div>\n</article>\n\n</div>\n\n</section>\n\n</section>"}

