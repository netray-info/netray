data: {"id":"spectrum","html":"<figure id=\"spectrum\" data-island=\"spectrum\" data-refreshing>\n\n<div class=\"spectrum\">\n  <div class=\"spectrum__box\" style=\"--spectrum-lines: 54\">\n    <div class=\"spectrum__label-band\" style=\"height: calc(var(--spectrum-label-band) + 0 * var(--spectrum-label-row))\">\n      \n      <div class=\"spectrum__labels\" data-run=\"0\" data-shown>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 8.3333%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 21.2963%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 60.1852%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 82.4074%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 99.0741%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"dns.ns\" style=\"left: clamp(0px, 8.3333%, calc(100% - 17.64px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">NS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"tls.chain_trusted\" style=\"left: clamp(0px, 21.2963%, calc(100% - 38.10px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Trust</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"http.hsts\" style=\"left: clamp(0px, 60.1852%, calc(100% - 31.28px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">HSTS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"email.spf\" style=\"left: clamp(0px, 82.4074%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">SPF</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"ip.reputation\" style=\"left: clamp(0px, 99.0741%, calc(100% - 24.46px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">Rep</span>\n        \n      </div>\n      \n      <div class=\"spectrum__labels\" data-run=\"1\">\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 8.3333%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 21.2963%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 60.1852%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 82.4074%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        <span class=\"spectrum__leader\" data-tone=\"warn\" style=\"left: 99.0741%; height: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\"></span>\n        \n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"dns.ns\" style=\"left: clamp(0px, 8.3333%, calc(100% - 17.64px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-label-row))\">NS</span>\n        \n        <span class=\"spectrum__line-label\" data-tone=\"warn\" data-code=\"tls.chain_trusted\" style=\"left: clamp(0px, 21.2963%, calc(100% - 38.10px)); bottom: calc(var(--spectrum-label-leader) + 0 * var(--spectrum-labe